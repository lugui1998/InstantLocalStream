{
  "name": "instant-local-stream-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build --configLoader runner",
    "licenses": "generate-license-file --input package.json --output ../packaging/THIRD_PARTY_LICENSES-NPM.txt --overwrite --eol lf --ci --no-spinner",
    "test": "vitest run --configLoader runner",
    "preview": "vite preview"
  },
  "dependencies": {
    "socket.io-client": "^4.8.1",
    "uplot": "^1.6.32",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "generate-license-file": "4.2.5",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.0"
  }
}
